{
  "name": "repair-cafe",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler types --strict-vars=false && astro dev",
    "build": "wrangler types --strict-vars=false && node --disable-warning=DEP0040 node_modules/astro/bin/astro.mjs build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "wrangler types --strict-vars=false && astro check",
    "types": "wrangler types --strict-vars=false",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file=migrations/seed.sql",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "hash": "node scripts/hash-wachtwoord.mjs",
    "account": "node scripts/maak-account.mjs",
    "account:wijzig": "node scripts/wijzig-account.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.4",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.143.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
