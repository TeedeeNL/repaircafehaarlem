# Kopieer naar .dev.vars (niet committen). Lokaal de publieke Turnstile-testsleutels:
# site key 1x00000000000000000000AA met secret 1x0000000000000000000000000000000AA = slaagt altijd
# secret 2x0000000000000000000000000000000AA = mislukt altijd
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Uitslagen van testsleutels accepteren. Nooit in productie zetten.
TURNSTILE_TESTMODUS=aan

# console = bevestigingsmail naar de terminal, uit = mail mislukt (test de variant "mail volgt later"),
# eusend = via EUSEND; vul dan ook EUSEND_API_KEY en MAIL_AFZENDER in (domein geverifieerd bij EUSEND).
# Met een eu_test_-sleutel loopt de hele verwerking (validatie, limieten) maar wordt er niets bezorgd.
MAIL_MODUS=console
EUSEND_API_KEY=
