---
// S8 Statistiek (W8, F-10). Afwijking van K7: on-demand in plaats van prerendered.
// De build op Cloudflare (Workers Builds) heeft geen productie-D1, dus de cijfers worden per verzoek
// gelezen en een uur gecachet. Mislukt de query, dan geen cijfers maar een melding (nooit verkeerde cijfers).
export const prerender = false;

import Layout from '../components/Layout.astro';
import Alert from '../components/Alert.astro';
import Icon from '../components/Icon.astro';
import Knop from '../components/Knop.astro';
import Label from '../components/Label.astro';
import PaginaKop from '../components/PaginaKop.astro';
import Marker from '../components/Marker.astro';
import { statistiek, type StatRij } from '../lib/db/reparatie';
import { datum } from '../lib/format';
import { vandaag } from '../lib/tijd';

const bijgewerktOp = vandaag();
let stat: { sessies: number; rijen: StatRij[] } | null = null;
try {
  stat = await statistiek(bijgewerktOp);
  Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=3600');
} catch (e) {
  console.error('Statistiek ophalen mislukt', { fout: e instanceof Error ? e.name : 'onbekend' });
  Astro.response.status = 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
}
const rijen = stat?.rijen ?? [];
const totaal = rijen.reduce((t, r) => t + r.aantal, 0);
const geslaagd = rijen.reduce((t, r) => t + r.geslaagd, 0);
const pct = (deel: number, geheel: number) => (geheel ? Math.round((deel / geheel) * 100) : 0);
---

<Layout titel="Statistieken" beschrijving="Wat Repair Cafe Haarlem de laatste zes sessies heeft gerepareerd.">
  <PaginaKop kopje="Statistieken" titel="Wat hebben we gerepareerd?" icoon="grafiek">
    {totaal > 0 && <p class="hero-in font-mono text-meta text-ink-muted" style="--i: 2">Laatste zes sessies · bijgewerkt op {datum(bijgewerktOp)}</p>}
  </PaginaKop>

  <div class="mx-auto flex max-w-page flex-col gap-12 px-rand py-12 md:py-16">
    {
      stat && totaal > 0 && stat.sessies < 6 && (
        <p class="flex max-w-[44rem] items-start gap-2.5 rounded-lg border-thin border-line-strong bg-surface px-4 py-3 text-small" data-reveal>
          <Marker soort="info" />
          <span>
            <strong>Gebaseerd op {stat.sessies} {stat.sessies === 1 ? 'sessie' : 'sessies'}.</strong> Zodra er zes zijn,
            tonen we steeds de laatste zes.
          </span>
        </p>
      )
    }

    {
      !stat ? (
        <Alert soort="warn" titel="De cijfers zijn nu niet beschikbaar.">
          Probeer het later nog eens.
        </Alert>
      ) : totaal > 0 ? (
        <>
          <div class="grid gap-10 pt-6 sm:grid-cols-2 lg:max-w-[48rem]">
            <Label as="div" kantel={-1.5} data-reveal style="--i: 0">
              <p class="font-display text-[clamp(3rem,2rem+4vw,4.5rem)] leading-none font-extrabold">{totaal}</p>
              <p class="mt-2 font-mono text-meta font-semibold tracking-[.14em] uppercase">apparaten</p>
            </Label>
            <Label as="div" kantel={1.5} variant="oranje" data-reveal style="--i: 1">
              <p class="font-display text-[clamp(3rem,2rem+4vw,4.5rem)] leading-none font-extrabold">{pct(geslaagd, totaal)}%</p>
              <p class="mt-2 font-mono text-meta font-semibold tracking-[.14em] uppercase">weer heel</p>
            </Label>
          </div>

          <section aria-labelledby="per-categorie" class="flex max-w-[48rem] flex-col gap-6">
            <h2 id="per-categorie" class="font-display text-kop-3 font-extrabold" data-reveal>Per categorie</h2>
            <ul class="flex flex-col gap-6">
              {rijen.map((r, i) => {
                const p = pct(r.geslaagd, r.aantal);
                return (
                  <li class="flex flex-col gap-2" data-reveal style={`--i: ${i}`}>
                    <div class="flex flex-wrap items-baseline justify-between gap-2">
                      <strong class="text-lead">{r.categorie}</strong>
                      <span class="font-mono text-small">
                        {r.aantal} stuks · <strong>{p}%</strong> geslaagd
                      </span>
                    </div>
                    <div class="meetlint" aria-hidden="true">
                      <div class="meetlint-vulling" style={`--pct: ${p / 100}`} />
                    </div>
                  </li>
                );
              })}
            </ul>
            <p class="text-small text-ink-muted">Geslaagd = gerepareerd of deels gerepareerd. Geen persoonsgegevens, alleen aantallen.</p>
          </section>
        </>
      ) : (
        <div class="leeg mx-auto flex w-full max-w-[34rem] flex-col items-center gap-4 px-6 py-12 text-center" data-reveal>
          <span class="grid size-20 place-items-center rounded-full border-thin border-ink bg-surface text-rust">
            <Icon naam="grafiek" maat={36} />
          </span>
          <p class="font-display text-kop-3 font-extrabold">Nog geen gegevens beschikbaar.</p>
          <p class="text-ink-muted">Na de eerste afgeronde sessie verschijnen hier de cijfers.</p>
        </div>
      )
    }

    <div data-reveal>
      <Knop href="/aanmelden" pijl>Apparaat aanmelden</Knop>
    </div>
  </div>
</Layout>

<style>
  .meetlint {
    position: relative;
    height: 22px;
    overflow: hidden;
    border: 1.5px solid var(--kleur-inkt);
    border-radius: var(--radius-sm);
    /* maatstreepjes zoals op een meetlint */
    background:
      repeating-linear-gradient(90deg, var(--kleur-inkt) 0 1px, transparent 1px 10%) 0 100% / 100% 45% no-repeat,
      repeating-linear-gradient(90deg, var(--kleur-lijn-sterk) 0 1px, transparent 1px 2%) 0 100% / 100% 25% no-repeat,
      var(--kleur-vlak);
  }
  .meetlint-vulling {
    position: absolute;
    inset: 0;
    background: var(--kleur-signaal);
    opacity: 0.9;
    transform: scaleX(var(--pct));
    transform-origin: left;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global([data-reveal].zichtbaar) .meetlint-vulling,
    :global(html:not(.js)) .meetlint-vulling {
      transition: transform 1.1s var(--ease-uit) 0.2s;
    }
    :global(html.js [data-reveal]:not(.zichtbaar)) .meetlint-vulling {
      transform: scaleX(0);
    }
  }
  .leeg {
    border: 2px dashed var(--kleur-lijn-sterk);
    border-radius: var(--radius-lg);
    background: var(--kleur-papier);
  }
</style>
