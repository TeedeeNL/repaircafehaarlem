---
// S5 Login vrijwilligers (W5, F-05, TE-04).
export const prerender = false;

import Layout from '../components/Layout.astro';
import Alert from '../components/Alert.astro';
import Icon from '../components/Icon.astro';
import Knop from '../components/Knop.astro';
import PaginaKop from '../components/PaginaKop.astro';
import FormField from '../components/FormField.astro';
import { vrijwilligerOpEmail } from '../lib/db/vrijwilliger';
import { controleerWachtwoord, doeAlsofControle } from '../lib/auth/wachtwoord';
import { startSessie } from '../lib/auth/sessie';
import { loginBlokkade, registreerMislukteLogin, wisMislukteLogins } from '../lib/auth/limiet';
import { LOGIN_VELDEN, loginSchema } from '../lib/schemas/login';
import { leesFormulier, valideer, type Fouten } from '../lib/schemas/formulier';

// Alleen interne paden als terugsprong, nooit een externe URL.
const veiligDoel = (pad: unknown) =>
  typeof pad === 'string' && /^\/(crew|beheer)(\/[a-z-]+)?(\?[\w=&%.+-]*)?$/.test(pad) ? pad : '/crew';

const terugParam = Astro.url.searchParams.get('terug');
if (Astro.locals.gebruiker && Astro.request.method === 'GET') return Astro.redirect(veiligDoel(terugParam), 302);

let email = '';
let fouten: Fouten = {};
let onjuist = false;
let blokkade = { geblokkeerd: false, minuten: 0 };
let terug = terugParam ? veiligDoel(terugParam) : '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  terug = form.get('terug') ? veiligDoel(form.get('terug')) : '';
  const check = valideer(loginSchema, leesFormulier(form, LOGIN_VELDEN));
  email = (check.succes ? check.data.email : check.waarden.email) ?? '';

  if (!check.succes) {
    fouten = check.fouten;
    Astro.response.status = 400;
  } else {
    blokkade = await loginBlokkade(check.data.email);
    if (!blokkade.geblokkeerd) {
      const v = await vrijwilligerOpEmail(check.data.email);
      const klopt = v
        ? await controleerWachtwoord(check.data.wachtwoord, v.salt, v.wachtwoord_hash)
        : await doeAlsofControle(check.data.wachtwoord);

      if (v && klopt) {
        await wisMislukteLogins(check.data.email);
        await startSessie(Astro.cookies, v.id);
        return Astro.redirect(terug || '/crew', 303);
      }
      // Zelfde melding bij onbekend adres en fout wachtwoord.
      if (await registreerMislukteLogin(check.data.email)) blokkade = { geblokkeerd: true, minuten: 15 };
      else onjuist = true;
    }
    Astro.response.status = blokkade.geblokkeerd ? 429 : 401;
  }
}

const doorverwezen = Boolean(terug) && Astro.request.method === 'GET';
---

<Layout titel="Inloggen vrijwilligers">
  <PaginaKop kopje="Vrijwilligers" titel="Inloggen vrijwilligers" icoon="persoon" smal />
  <div class="mx-auto max-w-[44rem] px-rand py-12 md:py-16">
    <form method="post" action="/login" novalidate class="werkbon mx-auto flex max-w-[28rem] flex-col gap-5">
      {
        doorverwezen && (
          <Alert soort="info">
            Log in om verder te gaan.
          </Alert>
        )
      }
      {onjuist && <Alert soort="error" titel="Onjuiste inloggegevens" />}
      {
        blokkade.geblokkeerd && (
          <Alert soort="warn" titel="Account tijdelijk geblokkeerd" id="geblokkeerd">
            Te veel mislukte pogingen. Probeer het over {blokkade.minuten} {blokkade.minuten === 1 ? 'minuut' : 'minuten'}{' '}
            opnieuw.
          </Alert>
        )
      }

      {terug && <input type="hidden" name="terug" value={terug} />}

      <FormField
        id="l-email"
        name="email"
        label="E-mailadres"
        type="email"
        inputmode="email"
        autocomplete="username"
        value={email}
        error={fouten.email}
        autofocus={Boolean(fouten.email)}
        required
      />
      <FormField
        id="l-wachtwoord"
        name="wachtwoord"
        label="Wachtwoord"
        type="password"
        autocomplete="current-password"
        toonKnop
        error={fouten.wachtwoord}
        autofocus={onjuist || (!fouten.email && Boolean(fouten.wachtwoord))}
        required
      />

      <Knop type="submit" breed pijl>Inloggen</Knop>
      <p class="flex items-start gap-2 text-small text-ink-muted">
        <Icon naam="info" maat={18} class="mt-0.5" />
        Geen account? De coördinator maakt accounts aan.
      </p>
    </form>
  </div>
</Layout>
