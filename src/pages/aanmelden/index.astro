---
// S2 Aanmeldformulier (W2, F-01 t/m F-04, TE-03, TE-05).
export const prerender = false;

import Layout from '../../components/Layout.astro';
import Alert from '../../components/Alert.astro';
import Button from '../../components/Button.astro';
import FieldError from '../../components/FieldError.astro';
import FormField from '../../components/FormField.astro';
import { CATEGORIEEN } from '../../lib/domein';
import { komendeSessies } from '../../lib/db/sessie';
import { maakAanmelding } from '../../lib/db/aanmelding';
import { AANMELDING_VELDEN, aanmeldingSchema } from '../../lib/schemas/aanmelding';
import { leesFormulier, valideer, type Fouten } from '../../lib/schemas/formulier';
import { turnstileSiteKey, verifieerTurnstile } from '../../lib/turnstile';
import { mailer } from '../../lib/mail';
import { bevestigingsmail } from '../../lib/mail/bevestiging';
import { onthoudBevestiging } from '../../lib/bevestiging';
import { datumKort, plekken } from '../../lib/format';
import { huidigJaar, vandaag } from '../../lib/tijd';

type Veld = (typeof AANMELDING_VELDEN)[number];

let waarden: Record<string, string> = {};
let fouten: Fouten = {};
let systeemfout = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  waarden = leesFormulier(form, AANMELDING_VELDEN);
  const token = form.get('cf-turnstile-response');
  const [check, mens] = await Promise.all([
    Promise.resolve(valideer(aanmeldingSchema, waarden)),
    verifieerTurnstile(typeof token === 'string' ? token : '', Astro.clientAddress),
  ]);

  if (!check.succes) fouten = { ...check.fouten };
  if (!mens) fouten.turnstile = 'De controle is mislukt, probeer het opnieuw.';

  if (check.succes && mens) {
    try {
      const res = await maakAanmelding(check.data, huidigJaar(), vandaag());
      if (res.soort === 'vol') {
        // F-03: tussen laden en verzenden vol geraakt. Keuze leegmaken, rest blijft staan.
        fouten.sessie_id = 'Deze sessie is inmiddels vol, kies een andere datum.';
        waarden.sessie_id = '';
        Astro.response.status = 409;
      } else if (res.soort === 'ongeldige_sessie') {
        fouten.sessie_id = 'Kies een sessie.';
        waarden.sessie_id = '';
        Astro.response.status = 400;
      } else {
        const sessie = (await komendeSessies(vandaag())).find((s) => s.id === check.data.sessie_id);
        // F-04: mail is niet leidend. Mislukt hij, dan blijft de aanmelding staan.
        let mailVerstuurd = false;
        try {
          await mailer().verstuur(
            bevestigingsmail({
              email: check.data.email,
              referentie: res.referentie,
              datum: sessie?.datum ?? '',
              starttijd: sessie?.starttijd ?? '',
              merk_type: check.data.merk_type,
              basisUrl: Astro.url.origin,
            }),
          );
          mailVerstuurd = true;
        } catch {
          console.error('Bevestigingsmail niet verstuurd', { referentie: res.referentie });
        }
        onthoudBevestiging(Astro.cookies, { referentie: res.referentie, email: check.data.email, mailVerstuurd });
        return Astro.redirect('/aanmelden/bevestiging', 303);
      }
    } catch (e) {
      // Geen persoonsgegevens in de log: alleen het soort fout.
      console.error('Aanmelding opslaan mislukt', { fout: e instanceof Error ? e.name : 'onbekend' });
      systeemfout = true;
      Astro.response.status = 500;
    }
  } else {
    Astro.response.status = 400;
  }
}

const sessies = await komendeSessies(vandaag());
const siteKey = turnstileSiteKey();

const labels: Record<Veld | 'turnstile', string> = {
  voornaam: 'Voornaam',
  email: 'E-mailadres',
  categorie: 'Categorie',
  merk_type: 'Merk en type',
  defect: 'Wat is er kapot?',
  sessie_id: 'Sessie',
  turnstile: 'Controle',
};
const volgorde = [...AANMELDING_VELDEN, 'turnstile'] as const;
const foutLijst = volgorde.filter((v) => fouten[v]);
const eersteFout = foutLijst[0];
const ankers: Record<string, string> = { turnstile: 'f-turnstile' };
---

<Layout titel="Apparaat aanmelden">
  <form
    method="post"
    action="/aanmelden"
    novalidate
    data-aanmelden
    class="mx-auto flex max-w-[560px] flex-col gap-5 px-4 pt-6 pb-14 lg:pt-8"
  >
    <div class="flex flex-col gap-1.5">
      <h1 class="font-display text-[30px] leading-[1.05] font-extrabold lg:text-[40px]">Meld je apparaat aan</h1>
      <p class="text-ink-muted">Alle velden zijn verplicht. Duurt zo’n twee minuten.</p>
    </div>

    {
      systeemfout && (
        <Alert soort="error" titel="Er ging iets mis, probeer het opnieuw.">
          Je ingevulde gegevens staan er nog. Er is niets opgeslagen.
        </Alert>
      )
    }

    {
      foutLijst.length > 0 && (
        <Alert soort="error" titel={foutLijst.length === 1 ? 'Controleer 1 veld' : `Controleer ${foutLijst.length} velden`}>
          <ul class="list-disc pl-[18px]">
            {foutLijst.map((v) => (
              <li>
                <a href={`#${ankers[v] ?? `f-${v}`}`} class="font-bold">
                  {labels[v]}
                </a>
              </li>
            ))}
          </ul>
        </Alert>
      )
    }

    <FormField
      id="f-voornaam"
      name="voornaam"
      label="Voornaam"
      autocomplete="given-name"
      value={waarden.voornaam}
      error={fouten.voornaam}
      autofocus={eersteFout === 'voornaam'}
      required
    />
    <FormField
      id="f-email"
      name="email"
      label="E-mailadres"
      type="email"
      inputmode="email"
      autocomplete="email"
      value={waarden.email}
      error={fouten.email}
      autofocus={eersteFout === 'email'}
      required
    />
    <FormField
      id="f-categorie"
      name="categorie"
      label="Categorie"
      as="select"
      leeg="Kies een categorie"
      options={CATEGORIEEN.map((c) => ({ value: c, label: c }))}
      value={waarden.categorie}
      error={fouten.categorie}
      autofocus={eersteFout === 'categorie'}
      required
    />
    <FormField
      id="f-merk_type"
      name="merk_type"
      label="Merk en type"
      hint="Staat meestal op een sticker aan de onderkant."
      value={waarden.merk_type}
      error={fouten.merk_type}
      autofocus={eersteFout === 'merk_type'}
      required
    />
    <FormField
      id="f-defect"
      name="defect"
      label="Wat is er kapot?"
      as="textarea"
      rows={4}
      hint="Minimaal 20 tekens"
      teller={500}
      value={waarden.defect}
      error={fouten.defect}
      autofocus={eersteFout === 'defect'}
      required
    />

    <fieldset
      id="f-sessie_id"
      tabindex="-1"
      aria-describedby={fouten.sessie_id ? 'f-sessie_id-fout' : undefined}
      class="flex min-w-0 flex-col gap-2 border-0 p-0"
    >
      <legend class="mb-2 p-0 font-bold">Sessie</legend>
      {fouten.sessie_id && <FieldError id="f-sessie_id-fout">{fouten.sessie_id}</FieldError>}

      {
        sessies.length === 0 ? (
          <Alert soort="info" role="status" id="geen-sessie-uitleg">
            <strong>Er is nu geen sessie open.</strong> De volgende datum wordt binnenkort bekend.
          </Alert>
        ) : (
          sessies.map((s) => {
            const vrij = Math.max(0, s.max_plekken - s.bezet);
            return vrij === 0 ? (
              <label class="flex min-h-card cursor-not-allowed items-center gap-3 rounded-xl border-thin border-dashed border-line-strong bg-sand-light px-3.5 py-2.5 text-ink-muted">
                <input type="radio" name="sessie_id" value={s.id} disabled class="m-0 size-[22px] flex-none" />
                <span class="flex-1">
                  <strong>{datumKort(s.datum)}</strong>, {s.starttijd}
                  <br />
                  <span class="text-sm">Vol, niet te kiezen</span>
                </span>
                <span class="rounded-full border border-ink-muted px-2 py-[3px] font-mono text-xs font-semibold">VOL</span>
              </label>
            ) : (
              <label class="flex min-h-card cursor-pointer items-center gap-3 rounded-xl border-thin border-line-strong bg-surface px-3.5 py-2.5 has-checked:border-2 has-checked:border-rust has-checked:bg-rust-50">
                <input
                  type="radio"
                  name="sessie_id"
                  value={s.id}
                  checked={waarden.sessie_id === String(s.id)}
                  autofocus={(eersteFout === 'sessie_id' && s === sessies.find((x) => x.max_plekken > x.bezet)) || undefined}
                  required
                  class="m-0 size-[22px] flex-none accent-rust"
                />
                <span class="flex-1">
                  <strong>{datumKort(s.datum)}</strong>, {s.starttijd}
                  <br />
                  <span class="text-sm">{plekken(vrij)} vrij</span>
                </span>
              </label>
            );
          })
        )
      }
    </fieldset>

    <div id="f-turnstile" tabindex="-1" class="flex flex-col gap-2">
      <div
        class:list={[
          'grid min-h-[68px] place-items-center rounded-lg px-1 text-center',
          fouten.turnstile ? 'border-2 border-error bg-stripes-sm' : 'border border-line bg-stripes-sm',
        ]}
      >
        <div class="cf-turnstile" data-sitekey={siteKey} data-language="nl" data-theme="light" data-size="flexible"></div>
        <noscript>
          <span class="text-sm">Zet JavaScript aan om de controle tegen spam te laten werken.</span>
        </noscript>
      </div>
      {fouten.turnstile && <FieldError id="f-turnstile-fout">{fouten.turnstile}</FieldError>}
    </div>

    {
      sessies.length === 0 ? (
        <Button uit breed aria-describedby="geen-sessie-uitleg">
          Aanmelden
        </Button>
      ) : (
        <Button type="submit" breed data-verzend>
          {systeemfout || fouten.turnstile ? 'Opnieuw aanmelden' : 'Aanmelden'}
        </Button>
      )
    }

    <p class="text-sm text-pretty text-ink-muted">
      We gebruiken je gegevens alleen voor deze aanmelding. Zes maanden na de sessie worden ze geanonimiseerd.
    </p>
  </form>
</Layout>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  // S2d: knop uit en "Bezig met verzenden…" tegen dubbel verzenden.
  const form = document.querySelector<HTMLFormElement>('[data-aanmelden]');
  const knop = form?.querySelector<HTMLButtonElement>('[data-verzend]');
  form?.addEventListener('submit', () => {
    if (!knop) return;
    knop.disabled = true;
    knop.setAttribute('aria-busy', 'true');
    knop.classList.add('bg-rust-700', 'cursor-progress');
    knop.textContent = 'Bezig met verzenden…';
  });
</script>
