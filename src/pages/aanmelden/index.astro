---
// S2 Aanmeldformulier (W2, F-01 t/m F-04, TE-03, TE-05).
export const prerender = false;

import Layout from '../../components/Layout.astro';
import Alert from '../../components/Alert.astro';
import Knop from '../../components/Knop.astro';
import Icon from '../../components/Icon.astro';
import PaginaKop from '../../components/PaginaKop.astro';
import FieldError from '../../components/FieldError.astro';
import FormField from '../../components/FormField.astro';
import { CATEGORIEEN } from '../../lib/domein';
import { komendeSessies } from '../../lib/db/sessie';
import { maakAanmelding } from '../../lib/db/aanmelding';
import { AANMELDING_VELDEN, aanmeldingSchema } from '../../lib/schemas/aanmelding';
import { leesFormulier, valideer, type Fouten } from '../../lib/schemas/formulier';
import { turnstileSiteKey, verifieerTurnstile } from '../../lib/turnstile';
import { mailer } from '../../lib/mail';
import { bevestigingsmail } from '../../lib/mail/bevestiging';
import { onthoudBevestiging } from '../../lib/bevestiging';
import { datumKort, plekken } from '../../lib/format';
import { huidigJaar, vandaag } from '../../lib/tijd';

type Veld = (typeof AANMELDING_VELDEN)[number];

let waarden: Record<string, string> = {};
let fouten: Fouten = {};
let systeemfout = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  waarden = leesFormulier(form, AANMELDING_VELDEN);
  const token = form.get('cf-turnstile-response');
  const [check, mens] = await Promise.all([
    Promise.resolve(valideer(aanmeldingSchema, waarden)),
    verifieerTurnstile(typeof token === 'string' ? token : '', Astro.clientAddress, 'aanmelden'),
  ]);

  if (!check.succes) fouten = { ...check.fouten };
  if (!mens) fouten.turnstile = 'De controle is mislukt, probeer het opnieuw.';

  if (check.succes && mens) {
    try {
      const res = await maakAanmelding(check.data, huidigJaar(), vandaag());
      if (res.soort === 'vol') {
        // F-03: tussen laden en verzenden vol geraakt. Keuze leegmaken, rest blijft staan.
        fouten.sessie_id = 'Deze sessie is inmiddels vol, kies een andere datum.';
        waarden.sessie_id = '';
        Astro.response.status = 409;
      } else if (res.soort === 'ongeldige_sessie') {
        fouten.sessie_id = 'Kies een sessie.';
        waarden.sessie_id = '';
        Astro.response.status = 400;
      } else {
        const sessie = (await komendeSessies(vandaag())).find((s) => s.id === check.data.sessie_id);
        // F-04: mail is niet leidend. Mislukt hij, dan blijft de aanmelding staan.
        let mailVerstuurd = false;
        try {
          await mailer().verstuur(
            bevestigingsmail({
              email: check.data.email,
              referentie: res.referentie,
              datum: sessie?.datum ?? '',
              starttijd: sessie?.starttijd ?? '',
              merk_type: check.data.merk_type,
              basisUrl: Astro.url.origin,
            }),
          );
          mailVerstuurd = true;
        } catch (e) {
          console.error('Bevestigingsmail niet verstuurd', {
            referentie: res.referentie,
            reden: e instanceof Error ? e.message : 'onbekend',
          });
        }
        onthoudBevestiging(Astro.cookies, { referentie: res.referentie, email: check.data.email, mailVerstuurd });
        return Astro.redirect('/aanmelden/bevestiging', 303);
      }
    } catch (e) {
      // Geen persoonsgegevens in de log: alleen het soort fout.
      console.error('Aanmelding opslaan mislukt', { fout: e instanceof Error ? e.name : 'onbekend' });
      systeemfout = true;
      Astro.response.status = 500;
    }
  } else {
    Astro.response.status = 400;
  }
}

const sessies = await komendeSessies(vandaag());
const siteKey = turnstileSiteKey();

const labels: Record<Veld | 'turnstile', string> = {
  voornaam: 'Voornaam',
  email: 'E-mailadres',
  categorie: 'Categorie',
  merk_type: 'Merk en type',
  defect: 'Wat is er kapot?',
  sessie_id: 'Sessie',
  turnstile: 'Controle',
};
const volgorde = [...AANMELDING_VELDEN, 'turnstile'] as const;
const foutLijst = volgorde.filter((v) => fouten[v]);
const eersteFout = foutLijst[0];
const ankers: Record<string, string> = { turnstile: 'f-turnstile' };
---

<Layout titel="Apparaat aanmelden">
  <PaginaKop kopje="Aanmelden" titel="Meld je apparaat aan" intro="Alle velden zijn verplicht. Duurt zo’n twee minuten." icoon="moersleutel" />

  <div class="mx-auto grid max-w-page items-start gap-10 px-rand py-10 md:py-14 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-14">
  <form
    method="post"
    action="/aanmelden"
    novalidate
    data-aanmelden
    class="werkbon flex min-w-0 flex-col gap-6"
  >

    {
      systeemfout && (
        <Alert soort="error" titel="Er ging iets mis, probeer het opnieuw.">
          Je ingevulde gegevens staan er nog. Er is niets opgeslagen.
        </Alert>
      )
    }

    {
      foutLijst.length > 0 && (
        <Alert soort="error" titel={foutLijst.length === 1 ? 'Controleer 1 veld' : `Controleer ${foutLijst.length} velden`}>
          <ul class="list-disc pl-[18px]">
            {foutLijst.map((v) => (
              <li>
                <a href={`#${ankers[v] ?? `f-${v}`}`} class="font-bold">
                  {labels[v]}
                </a>
              </li>
            ))}
          </ul>
        </Alert>
      )
    }

    <fieldset class="groep">
      <legend class="groep-kop"><span aria-hidden="true">01</span> Over jou</legend>
    <FormField
      id="f-voornaam"
      name="voornaam"
      label="Voornaam"
      autocomplete="given-name"
      value={waarden.voornaam}
      error={fouten.voornaam}
      autofocus={eersteFout === 'voornaam'}
      required
    />
    <FormField
      id="f-email"
      name="email"
      label="E-mailadres"
      type="email"
      inputmode="email"
      autocomplete="email"
      value={waarden.email}
      error={fouten.email}
      autofocus={eersteFout === 'email'}
      required
    />
    </fieldset>

    <div class="scheiding" aria-hidden="true"></div>
    <fieldset class="groep">
      <legend class="groep-kop"><span aria-hidden="true">02</span> Over het apparaat</legend>
    <FormField
      id="f-categorie"
      name="categorie"
      label="Categorie"
      as="select"
      leeg="Kies een categorie"
      options={CATEGORIEEN.map((c) => ({ value: c, label: c }))}
      value={waarden.categorie}
      error={fouten.categorie}
      autofocus={eersteFout === 'categorie'}
      required
    />
    <FormField
      id="f-merk_type"
      name="merk_type"
      label="Merk en type"
      hint="Staat meestal op een sticker aan de onderkant."
      value={waarden.merk_type}
      error={fouten.merk_type}
      autofocus={eersteFout === 'merk_type'}
      required
    />
    <FormField
      id="f-defect"
      name="defect"
      label="Wat is er kapot?"
      as="textarea"
      rows={4}
      hint="Minimaal 20 tekens"
      teller={500}
      value={waarden.defect}
      error={fouten.defect}
      autofocus={eersteFout === 'defect'}
      required
    />
    </fieldset>

    <div class="scheiding" aria-hidden="true"></div>
    <fieldset
      id="f-sessie_id"
      tabindex="-1"
      aria-describedby={fouten.sessie_id ? 'f-sessie_id-fout' : undefined}
      class="groep"
    >
      <legend class="groep-kop"><span aria-hidden="true">03</span> Sessie</legend>
      {fouten.sessie_id && <FieldError id="f-sessie_id-fout">{fouten.sessie_id}</FieldError>}

      {
        sessies.length === 0 ? (
          <Alert soort="info" role="status" id="geen-sessie-uitleg">
            <strong>Er is nu geen sessie open.</strong> De volgende datum wordt binnenkort bekend.
          </Alert>
        ) : (
          sessies.map((s) => {
            const vrij = Math.max(0, s.max_plekken - s.bezet);
            return vrij === 0 ? (
              <label class="sessie-optie sessie-vol">
                <input type="radio" name="sessie_id" value={s.id} disabled class="m-0 size-[22px] flex-none" />
                <span class="flex-1">
                  <strong>{datumKort(s.datum)}</strong>, {s.starttijd}
                  <br />
                  <span class="text-sm">Vol, niet te kiezen</span>
                </span>
                <span class="rounded-full border border-ink-muted px-2 py-[3px] font-mono text-xs font-semibold">VOL</span>
              </label>
            ) : (
              <label class="sessie-optie">
                <input
                  type="radio"
                  name="sessie_id"
                  value={s.id}
                  checked={waarden.sessie_id === String(s.id)}
                  autofocus={(eersteFout === 'sessie_id' && s === sessies.find((x) => x.max_plekken > x.bezet)) || undefined}
                  required
                  class="m-0 size-[22px] flex-none accent-rust"
                />
                <span class="flex-1">
                  <strong>{datumKort(s.datum)}</strong>, {s.starttijd}
                  <br />
                  <span class="text-sm">{plekken(vrij)} vrij</span>
                </span>
                <span class="sessie-vink text-rust" aria-hidden="true"><Icon naam="vink" maat={22} /></span>
              </label>
            );
          })
        )
      }
    </fieldset>

    <div class="scheiding" aria-hidden="true"></div>
    <div id="f-turnstile" tabindex="-1" class="flex flex-col gap-2">
      <p class="font-bold">Controle tegen spam</p>
      <div class:list={['ts-vak', fouten.turnstile && 'ts-vak-fout']}>
        <div
          class="cf-turnstile"
          data-sitekey={siteKey}
          data-action="aanmelden"
          data-language="nl"
          data-theme="light"
          data-size="flexible"
          data-error-callback="rcTurnstileFout"
        ></div>
        <p class="ts-laden text-sm text-ink-muted" data-ts-laden aria-hidden="true">Controle wordt geladen…</p>
        <noscript>
          <p class="text-sm">Zet JavaScript aan om de controle tegen spam te laten werken.</p>
        </noscript>
      </div>
      <p class="text-sm text-ink-muted" data-ts-fout role="status" hidden>
        De controle tegen spam kon niet laden. Zet een adblocker of strenge privacy-instelling voor deze site uit, of probeer
        een andere browser, en laad de pagina opnieuw.
      </p>
      {fouten.turnstile && <FieldError id="f-turnstile-fout">{fouten.turnstile}</FieldError>}
    </div>

    {
      sessies.length === 0 ? (
        <Knop uit breed aria-describedby="geen-sessie-uitleg">
          Aanmelden
        </Knop>
      ) : (
        <Knop type="submit" breed pijl data-verzend>
          {systeemfout || fouten.turnstile ? 'Opnieuw aanmelden' : 'Aanmelden'}
        </Knop>
      )
    }

    <p class="text-sm text-pretty text-ink-muted">
      We gebruiken je gegevens alleen voor deze aanmelding. Zes maanden na de sessie worden ze geanonimiseerd.
    </p>
  </form>

  <aside aria-labelledby="goed-om-te-weten-kop" class="flex flex-col gap-4 lg:sticky lg:top-28">
    <div class="rounded-xl border-thin border-ink bg-surface p-5 shadow-card">
      <h2 id="goed-om-te-weten-kop" class="flex items-center gap-2 font-mono text-meta font-semibold tracking-[.14em] text-rust uppercase">
        <Icon naam="label" maat={18} />
        Goed om te weten
      </h2>
      <ul class="mt-3 flex flex-col">
        <li class="border-b border-dashed border-line-strong py-2.5 text-small">Eén apparaat per persoon per sessie.</li>
        <li class="border-b border-dashed border-line-strong py-2.5 text-small">Je blijft erbij en kijkt mee tijdens de reparatie.</li>
        <li class="py-2.5 text-small">Reparatie is gratis. Nieuwe onderdelen betaal je zelf.</li>
      </ul>
      <a href="/info/huisregels" class="mt-2 inline-flex min-h-touch items-center gap-2 text-small font-bold">
        Alle huisregels <Icon naam="pijl-rechts" maat={16} />
      </a>
    </div>
  </aside>
  </div>
</Layout>

<style>
  .groep {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
    border: 0;
    padding: 0;
  }
  /* Losse scheidingslijn: een fieldset-rand zou door de legend heen lopen */
  .scheiding {
    border-top: 1.5px dashed var(--kleur-lijn-sterk);
  }
  .groep-kop {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.25rem;
    padding: 0;
    font-family: var(--font-rc-display);
    font-size: 1.375rem;
    font-weight: 800;
  }
  .groep-kop span {
    font-family: var(--font-rc-mono);
    font-size: var(--tekst-xs);
    font-weight: 600;
    color: var(--kleur-oranje);
    letter-spacing: 0.1em;
  }
  .sessie-optie {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-height: 64px;
    padding: 0.7rem 1rem;
    border: 1.5px solid var(--kleur-lijn-sterk);
    border-left-width: 6px;
    border-radius: var(--radius-md);
    background: var(--kleur-papier);
    cursor: pointer;
    transition:
      border-color var(--duur-basis) var(--ease-uit),
      background-color var(--duur-basis) var(--ease-uit),
      transform var(--duur-snel) var(--ease-uit);
  }
  .sessie-optie:hover {
    border-color: var(--kleur-inkt);
  }
  .sessie-optie:active {
    transform: translateY(1px);
  }
  .sessie-optie:has(:checked) {
    border-color: var(--kleur-oranje);
    background: var(--kleur-oranje-zacht);
  }
  .sessie-optie input {
    width: 22px;
    height: 22px;
    margin: 0;
    flex: none;
    accent-color: var(--kleur-oranje);
  }
  /* Op een eigen span: scoped CSS bereikt de <svg> van het Icon-component niet. */
  .sessie-vink {
    display: inline-flex;
    opacity: 0;
    transform: scale(0.5);
    transition:
      opacity var(--duur-basis) var(--ease-uit),
      transform var(--duur-basis) var(--ease-veer);
  }
  .sessie-optie:has(:checked) .sessie-vink {
    opacity: 1;
    transform: scale(1);
  }
  /* Turnstile: de widget is minimaal 300px breed. Op smalle schermen mag het vak de werkbonrand in. */
  .ts-vak {
    position: relative;
    display: grid;
    min-height: 72px;
    border: 1.5px dashed var(--kleur-lijn-sterk);
    border-radius: var(--radius-md);
    background: var(--kleur-papier);
  }
  .ts-vak-fout {
    border: 2px solid var(--kleur-fout);
  }
  .ts-vak > * {
    grid-area: 1 / 1;
  }
  .ts-laden {
    align-self: center;
    justify-self: center;
  }
  @media (max-width: 400px) {
    .ts-vak {
      margin-inline: -0.75rem;
    }
  }
  .sessie-vol {
    border-style: dashed;
    background: var(--kleur-zand-licht);
    color: var(--kleur-inkt-zacht);
    cursor: not-allowed;
  }
  .sessie-vol:hover {
    border-color: var(--kleur-lijn-sterk);
  }
</style>

<script is:inline>
  // Turnstile: "laden" weg zodra de widget er staat; uitleg tonen als het script niet laadt of een fout geeft.
  (function () {
    var vak = document.querySelector('.cf-turnstile');
    var laden = document.querySelector('[data-ts-laden]');
    var fout = document.querySelector('[data-ts-fout]');
    if (!vak) return;
    var toonFout = function () {
      if (laden) laden.hidden = true;
      if (fout) fout.hidden = false;
    };
    window.rcTurnstileFout = toonFout;
    new MutationObserver(function () {
      if (vak.childElementCount > 0 && laden) laden.hidden = true;
    }).observe(vak, { childList: true });
    setTimeout(function () {
      if (!window.turnstile || vak.childElementCount === 0) toonFout();
    }, 10000);
  })();
</script>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer onerror="window.rcTurnstileFout && window.rcTurnstileFout()"></script>
<script>
  // S2d: knop uit en "Bezig met verzenden…" tegen dubbel verzenden.
  const form = document.querySelector<HTMLFormElement>('[data-aanmelden]');
  const knop = form?.querySelector<HTMLButtonElement>('[data-verzend]');
  form?.addEventListener('submit', () => {
    if (!knop) return;
    knop.disabled = true;
    knop.setAttribute('aria-busy', 'true');
    knop.style.cursor = 'progress';
    knop.textContent = 'Bezig met verzenden…';
  });
</script>
