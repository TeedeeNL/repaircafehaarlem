---
// S6 Werklijst + uitkomstformulier (W6, FE-06, FE-07). Alleen ingelogd (middleware).
// Vrijwilligers zien hier de aanmeldingen van één sessie, met filters, en leggen per apparaat de uitkomst vast.
// De toegangscontrole doet src/middleware.ts: deze pagina leest alleen Astro.locals.gebruiker.
// Filters staan in de URL (?sessie=&categorie=&status=), zodat je een gefilterde lijst kunt delen of verversen.
export const prerender = false;

import Layout from '../components/Layout.astro';
import Alert from '../components/Alert.astro';
import Button from '../components/Button.astro';
import EmptyState from '../components/EmptyState.astro';
import FieldError from '../components/FieldError.astro';
import FormField from '../components/FormField.astro';
import StatusBadge from '../components/StatusBadge.astro';
import Table from '../components/Table.astro';
import { AANMELDING_STATUSSEN, CATEGORIEEN, UITKOMSTEN } from '../lib/domein';
import { alleSessies, sessieOpId, standaardWerklijstSessie } from '../lib/db/sessie';
import { werklijst, type WerklijstRij } from '../lib/db/aanmelding';
import { slaUitkomstOp } from '../lib/db/reparatie';
import { UITKOMST_VELDEN, uitkomstSchema } from '../lib/schemas/uitkomst';
import { leesFormulier, valideer, type Fouten } from '../lib/schemas/formulier';
import { datumKort } from '../lib/format';
import { vandaag } from '../lib/tijd';

// Het uitroepteken (!) zegt tegen TypeScript: dit is niet null. Dat klopt, want de middleware stuurt
// niet-ingelogde bezoekers weg voordat deze pagina draait.
const gebruiker = Astro.locals.gebruiker!;
const q = Astro.url.searchParams;

// Filters (FE-06). Onbekende waarden vallen terug op "alle".
// URL-parameters komen van de gebruiker en zijn dus niet te vertrouwen. We accepteren alleen cijfers voor de sessie
// en alleen waarden uit onze vaste lijsten voor categorie en status. Al het andere wordt genegeerd.
const gekozen = /^\d{1,9}$/.test(q.get('sessie') ?? '') ? await sessieOpId(Number(q.get('sessie'))) : null;
const sessie = gekozen ?? (await standaardWerklijstSessie(vandaag()));
const categorie = CATEGORIEEN.find((c) => c === q.get('categorie')) ?? null;
const status = AANMELDING_STATUSSEN.find((s) => s.value === q.get('status'))?.value ?? null;
const opgeslagenParam = q.get('opgeslagen');
const opgeslagen = opgeslagenParam && /^RC-\d{4}-\d{4}$/.test(opgeslagenParam) ? opgeslagenParam : null;

// Bouwt een link met de huidige filters. De parameters gaan door URLSearchParams, die tekens veilig codeert.
const filterUrl = (extra: Record<string, string> = {}) => {
  const p = new URLSearchParams();
  if (sessie) p.set('sessie', String(sessie.id));
  if (categorie) p.set('categorie', categorie);
  if (status) p.set('status', status);
  for (const [k, v] of Object.entries(extra)) p.set(k, v);
  const s = p.toString();
  return s ? `/crew?${s}` : '/crew';
};

// FE-07: uitkomst vastleggen. Bij een fout blijft het formulier open en ingevuld.
let openId: number | null = null;
let postWaarden: Record<string, string> | null = null;
let formFouten: Fouten = {};
let opslaanMislukt = false;

if (Astro.request.method === 'POST') {
  const check = valideer(uitkomstSchema, leesFormulier(await Astro.request.formData(), UITKOMST_VELDEN));
  if (check.succes) {
    try {
      // We geven het id van de ingelogde gebruiker mee uit de sessie en niet uit het formulier.
      // Een vrijwilliger kan dus geen uitkomst op naam van een ander vastleggen.
      const referentie = await slaUitkomstOp(check.data, gebruiker.id);
      // Post/Redirect/Get (303): na het opslaan een GET, zodat verversen niet opnieuw opslaat.
      if (referentie) return Astro.redirect(filterUrl({ opgeslagen: referentie }), 303);
      formFouten = { uitkomst: 'Deze aanmelding bestaat niet (meer) of is geannuleerd.' };
      Astro.response.status = 404;
    } catch (e) {
      // Privacy: alleen het id en het soort fout in de log, geen namen of notities.
      console.error('Uitkomst opslaan mislukt', { aanmelding: check.data.aanmelding_id, fout: e instanceof Error ? e.name : 'onbekend' });
      opslaanMislukt = true;
      Astro.response.status = 500;
    }
    openId = check.data.aanmelding_id;
  } else {
    formFouten = check.fouten;
    openId = Number(check.waarden.aanmelding_id) || null;
    Astro.response.status = 400;
  }
  postWaarden = check.succes
    ? { uitkomst: check.data.uitkomst, minuten: String(check.data.minuten), notitie: check.data.notitie }
    : check.waarden;
}

const sessies = await alleSessies();
const { totaal, rijen } = sessie ? await werklijst(sessie.id, { categorie, status }) : { totaal: 0, rijen: [] as WerklijstRij[] };
const filterActief = categorie !== null || status !== null;
const openRef = q.get('open');

const isOpen = (a: WerklijstRij) => (openId !== null ? a.id === openId : a.referentie === openRef);

// Formulierwaarden per rij: na een mislukte POST de ingevulde waarden, anders een bestaande reparatie.
function invoerVoor(a: WerklijstRij) {
  if (postWaarden && a.id === openId) return { uitkomst: postWaarden.uitkomst ?? '', minuten: postWaarden.minuten ?? '', notitie: postWaarden.notitie ?? '' };
  return a.uitkomst
    ? { uitkomst: a.uitkomst, minuten: String(a.minuten ?? ''), notitie: a.notitie ?? '' }
    : { uitkomst: '', minuten: '', notitie: '' };
}

const telling = `${totaal} ${totaal === 1 ? 'aanmelding' : 'aanmeldingen'}`;
const cel = 'px-3 py-1.5 align-middle max-md:block max-md:p-0';
---

<Layout titel="Werklijst" variant="crew" gebruiker={gebruiker} tab="werklijst">
  <div class="mx-auto flex max-w-page flex-col gap-3.5 px-4 pt-4 pb-14 md:pt-5">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
      <div class="flex flex-col gap-0.5">
        <h1 class="font-display text-xl font-extrabold md:text-2xl">
          <span class="max-md:sr-only">Werklijst · </span>{sessie ? datumKort(sessie.datum, true) : 'Nog geen sessies'}
        </h1>
        <p class="text-sm text-ink-muted">
          {telling}
          {
            filterActief && (
              <>
                {' · '}
                <strong class="text-ink">{rijen.length} na filteren</strong>
              </>
            )
          }
        </p>
      </div>

      <form method="get" action="/crew" data-filter class="grid w-full grid-cols-2 items-end gap-2 md:flex md:w-auto md:flex-wrap">
        <div class="col-span-2 flex flex-col gap-0.5 md:w-[190px]">
          <label for="w-sessie" class="text-meta font-bold">Sessie</label>
          <div class="relative">
            <select id="w-sessie" name="sessie" class="min-h-touch w-full appearance-none rounded-lg border-thin border-line-strong bg-surface pr-7 pl-2.5 text-sm">
              {
                sessies.map((s) => (
                    <option value={s.id} selected={s.id === sessie?.id}>
                      {datumKort(s.datum, true)}
                    </option>
                  ))
              }
            </select>
            <span aria-hidden="true" class="pointer-events-none absolute top-1/2 right-2.5 -translate-y-1/2 text-sm">▾</span>
          </div>
        </div>
        <div class="flex min-w-0 flex-col gap-0.5 md:w-[190px]">
          <label for="w-categorie" class="text-meta font-bold">Categorie</label>
          <div class="relative">
            <select
              id="w-categorie"
              name="categorie"
              class:list={[
                'min-h-touch w-full appearance-none rounded-lg border-thin bg-surface pr-7 pl-2.5 text-sm',
                categorie ? 'border-ink' : 'border-line-strong',
              ]}
            >
              <option value="alle">Alle categorieën</option>
              {CATEGORIEEN.map((c) => <option selected={c === categorie}>{c}</option>)}
            </select>
            <span aria-hidden="true" class="pointer-events-none absolute top-1/2 right-2.5 -translate-y-1/2 text-sm">▾</span>
          </div>
        </div>
        <div class="flex min-w-0 flex-col gap-0.5 md:w-[170px]">
          <label for="w-status" class="text-meta font-bold">Status</label>
          <div class="relative">
            <select
              id="w-status"
              name="status"
              class:list={[
                'min-h-touch w-full appearance-none rounded-lg border-thin bg-surface pr-7 pl-2.5 text-sm',
                status ? 'border-ink' : 'border-line-strong',
              ]}
            >
              <option value="alle">Alle statussen</option>
              {AANMELDING_STATUSSEN.map((s) => <option value={s.value} selected={s.value === status}>{s.label}</option>)}
            </select>
            <span aria-hidden="true" class="pointer-events-none absolute top-1/2 right-2.5 -translate-y-1/2 text-sm">▾</span>
          </div>
        </div>
        <noscript>
          <button type="submit" class="min-h-touch rounded-lg bg-ink px-4 font-bold text-surface">Filteren</button>
        </noscript>
      </form>
    </div>

    {
      opgeslagen && (
        <Alert soort="ok" compact>
          Uitkomst opgeslagen voor <strong class="font-mono">{opgeslagen}</strong>
        </Alert>
      )
    }

    {
      !sessie || totaal === 0 ? (
        <EmptyState titel="Er zijn nog geen aanmeldingen voor deze sessie." tekst="Nieuwe aanmeldingen verschijnen hier vanzelf." />
      ) : rijen.length === 0 ? (
        <EmptyState titel="Geen aanmeldingen die aan het filter voldoen.">
          <Button slot="actie" href={`/crew?sessie=${sessie?.id ?? ''}`} variant="secundair" maat="crew">
            Filter wissen
          </Button>
        </EmptyState>
      ) : (
        <Table
          stapel
          bijschrift={`Aanmeldingen voor ${sessie ? datumKort(sessie.datum, true) : ''}`}
          kolommen={[
            { label: 'Referentie' },
            { label: 'Categorie' },
            { label: 'Merk en type' },
            { label: 'Defect' },
            { label: 'Status' },
            { label: 'Actie', class: 'text-right' },
          ]}
        >
          {rijen.map((a) => {
            const r = a.uitkomst;
            const open = isOpen(a);
            const inv = invoerVoor(a);
            const fouten: Fouten = open ? formFouten : {};
            const pre = `o-${a.id}`;
            return (
              <>
                <tr
                  id={`rij-${a.referentie}`}
                  data-rij={a.id}
                  class:list={[
                    'border-b border-line max-md:grid max-md:grid-cols-[1fr_auto] max-md:gap-x-3 max-md:gap-y-1.5 max-md:py-2.5',
                    open && 'bg-rust-50 max-md:border-b-0 max-md:px-2',
                  ]}
                >
                  <td class:list={[cel, 'font-mono font-semibold whitespace-nowrap max-md:text-meta md:pl-4 lg:pl-6']}>{a.referentie}</td>
                  <td class:list={[cel, 'max-md:hidden']}>{a.categorie}</td>
                  <td class:list={[cel, 'font-bold max-md:col-span-2 max-md:text-small']}>
                    {a.merk_type}
                    <span class="font-normal md:hidden">
                      {' · '}
                      <span class="text-ink-muted">{a.categorie}</span>
                    </span>
                  </td>
                  <td class:list={[cel, 'text-ink-muted max-md:col-span-2']}>{a.defect}</td>
                  <td class:list={[cel, 'max-md:col-start-2 max-md:row-start-1 max-md:justify-self-end']}>
                    <StatusBadge status={r ?? a.status} maat="sm" />
                  </td>
                  <td class:list={[cel, 'text-right max-md:col-span-2 md:pr-4 lg:pr-6']}>
                    {a.status !== 'geannuleerd' && (
                    <a
                      href={open ? filterUrl() : `${filterUrl({ open: a.referentie })}#rij-${a.referentie}`}
                      data-toggle={`${pre}-rij`}
                      aria-expanded={open}
                      aria-controls={`${pre}-rij`}
                      class="inline-flex min-h-touch items-center justify-center rounded-lg border-thin border-ink bg-surface px-3 text-sm font-bold whitespace-nowrap text-ink no-underline hover:bg-paper hover:text-ink max-md:w-full"
                    >
                      <span data-label-dicht hidden={open}>
                        {r ? 'Bekijken' : 'Uitkomst vastleggen'}
                      </span>
                      <span data-label-open hidden={!open}>
                        Sluiten
                      </span>
                    </a>
                    )}
                  </td>
                </tr>
                <tr id={`${pre}-rij`} hidden={!open} class="border-b border-line bg-rust-50 max-md:block max-md:px-2 max-md:pb-3">
                  <td colspan="6" class="px-4 pt-1 pb-4 max-md:block max-md:p-0 lg:px-6">
                    <form
                      method="post"
                      action={filterUrl()}
                      novalidate
                      aria-label={`Uitkomst vastleggen voor ${a.referentie}`}
                      class="grid gap-3.5 rounded-xl border-thin border-ink bg-surface p-3.5 md:grid-cols-[minmax(0,auto)_180px_minmax(0,1fr)] md:items-start"
                    >
                      <input type="hidden" name="aanmelding_id" value={a.id} />
                      {open && opslaanMislukt && (
                        <Alert soort="error" compact class="md:col-span-3">
                          <strong class="text-error">Opslaan is niet gelukt, probeer opnieuw.</strong> Je invoer staat er nog.
                        </Alert>
                      )}
                      <fieldset
                        id={`${pre}-uitkomst`}
                        tabindex="-1"
                        aria-describedby={fouten.uitkomst ? `${pre}-uitkomst-fout` : undefined}
                        class="min-w-0 border-0 p-0"
                      >
                        <legend class="mb-1 p-0 text-meta font-bold">Uitkomst</legend>
                        <div
                          class:list={[
                            'grid grid-cols-3 overflow-hidden rounded-lg text-sm font-bold',
                            fouten.uitkomst ? 'border-2 border-error' : 'border-thin border-ink',
                          ]}
                        >
                          {UITKOMSTEN.map((u, i) => (
                            <label
                              class:list={[
                                'group flex min-h-touch cursor-pointer items-center justify-center px-2 text-center has-checked:bg-ink has-checked:text-surface has-focus-visible:outline-3 has-focus-visible:-outline-offset-4 has-focus-visible:outline-rust',
                                i > 0 && 'border-l-thin border-ink',
                              ]}
                            >
                              <input
                                type="radio"
                                name="uitkomst"
                                value={u.value}
                                checked={inv.uitkomst === u.value}
                                autofocus={(i === 0 && Boolean(fouten.uitkomst)) || undefined}
                                class="sr-only"
                              />
                              <span aria-hidden="true" class="hidden group-has-checked:inline">
                                ✓&nbsp;
                              </span>
                              {u.label}
                            </label>
                          ))}
                        </div>
                        {fouten.uitkomst && (
                          <FieldError id={`${pre}-uitkomst-fout`} maat="crew" class="mt-1">
                            {fouten.uitkomst}
                          </FieldError>
                        )}
                      </fieldset>
                      <FormField
                        id={`${pre}-minuten`}
                        name="minuten"
                        label="Bestede tijd (minuten)"
                        inputmode="numeric"
                        maat="compact"
                        veldClass="max-md:w-[120px]"
                        value={inv.minuten}
                        error={fouten.minuten}
                        required
                      />
                      <FormField
                        id={`${pre}-notitie`}
                        name="notitie"
                        label="Notitie"
                        as="textarea"
                        rows={2}
                        teller={300}
                        maat="compact"
                        value={inv.notitie}
                        error={fouten.notitie}
                      />
                      <div class="flex flex-wrap gap-2 md:col-span-3">
                        <Button type="submit" variant="crew" maat="crew" class="max-md:flex-1">
                          {open && opslaanMislukt ? 'Opnieuw opslaan' : r ? 'Bijwerken' : 'Opslaan'}
                        </Button>
                        <Button href={filterUrl()} variant="crew-secundair" maat="crew" data-sluit={`${pre}-rij`}>
                          Annuleren
                        </Button>
                      </div>
                    </form>
                  </td>
                </tr>
              </>
            );
          })}
        </Table>
      )
    }
  </div>
</Layout>

<script>
  // Filters direct toepassen bij wijzigen.
  const filter = document.querySelector<HTMLFormElement>('[data-filter]');
  filter?.addEventListener('change', () => filter.requestSubmit());

  // Uitkomstformulier in- en uitklappen zonder herladen. Zonder JS werken de links via ?open=.
  function zet(knop: HTMLElement, open: boolean) {
    const rij = document.getElementById(knop.dataset.toggle!);
    if (!rij) return;
    rij.hidden = !open;
    knop.setAttribute('aria-expanded', String(open));
    knop.querySelector<HTMLElement>('[data-label-dicht]')!.hidden = open;
    knop.querySelector<HTMLElement>('[data-label-open]')!.hidden = !open;
    const hoofdrij = knop.closest('tr');
    hoofdrij?.classList.toggle('bg-rust-50', open);
    if (open) rij.querySelector<HTMLInputElement>('input[name="uitkomst"]:checked, input[name="uitkomst"]')?.focus();
  }
  for (const knop of document.querySelectorAll<HTMLAnchorElement>('[data-toggle]')) {
    knop.setAttribute('role', 'button');
    knop.addEventListener('click', (e) => {
      e.preventDefault();
      zet(knop, knop.getAttribute('aria-expanded') !== 'true');
    });
  }
  for (const sluit of document.querySelectorAll<HTMLAnchorElement>('[data-sluit]')) {
    sluit.addEventListener('click', (e) => {
      const knop = document.querySelector<HTMLElement>(`[data-toggle="${sluit.dataset.sluit}"]`);
      if (!knop) return;
      e.preventDefault();
      zet(knop, false);
      knop.focus();
    });
  }
</script>
