---
// S4 Statusopvraag (W4, F-09). Maximaal 10 pogingen per kwartier per IP-adres.
export const prerender = false;

import Layout from '../components/Layout.astro';
import Alert from '../components/Alert.astro';
import Icon from '../components/Icon.astro';
import Knop from '../components/Knop.astro';
import Label from '../components/Label.astro';
import PaginaKop from '../components/PaginaKop.astro';
import FormField from '../components/FormField.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { aanmeldingVoorOpvraag, type AanmeldingDetail } from '../lib/db/aanmelding';
import { statusOpvraagToegestaan } from '../lib/auth/limiet';
import { STATUS_VELDEN, statusSchema } from '../lib/schemas/status';
import { leesFormulier, valideer, type Fouten } from '../lib/schemas/formulier';
import { datum } from '../lib/format';

let invoer: Record<string, string> = { referentie: '', email: '' };
let fouten: Fouten = {};
let gevonden: AanmeldingDetail | null = null;
let nietGevonden = false;
let geblokkeerd = false;

if (Astro.request.method === 'POST') {
  const check = valideer(statusSchema, leesFormulier(await Astro.request.formData(), STATUS_VELDEN));
  invoer = check.succes ? check.data : check.waarden;
  if (!(await statusOpvraagToegestaan(Astro.clientAddress))) {
    geblokkeerd = true;
    Astro.response.status = 429;
  } else if (!check.succes) {
    fouten = check.fouten;
    Astro.response.status = 400;
  } else {
    // Eén melding voor elke niet-kloppende combinatie: niet af te leiden welk gegeven fout is.
    gevonden = await aanmeldingVoorOpvraag(check.data.referentie, check.data.email);
    nietGevonden = !gevonden;
    if (nietGevonden) Astro.response.status = 404;
  }
}

const reparatie = gevonden?.uitkomst ? gevonden : null;
---

<Layout titel="Status opvragen">
  <PaginaKop kopje="Status opvragen" titel={gevonden ? 'Je aanmelding' : 'Hoe staat het met je apparaat?'} icoon="zoek" />

  <div class="mx-auto grid max-w-page items-start gap-12 px-rand py-12 md:py-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-16">
    {
      gevonden ? (
        <>
          <div class="pt-10">
            <Label as="section" kantel={-1.2} zwaai={false} class="instempelen max-w-[32rem]" aria-label={`Aanmelding ${gevonden.referentie}`}>
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="font-mono text-meta font-semibold tracking-[.16em] text-ink-muted">REFERENTIENUMMER</span>
                <StatusBadge status={gevonden.status} />
              </div>
              <p class="mt-1 font-mono text-[1.75rem] leading-[1.1] font-semibold break-all">{gevonden.referentie}</p>
              <hr class="scheur" />
              <dl class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 text-small">
                <dt class="py-2 text-ink-muted">Sessie</dt>
                <dd class="py-2 font-bold">{datum(gevonden.datum)}</dd>
                <dt class="border-t border-dashed border-line-strong py-2 text-ink-muted">Apparaat</dt>
                <dd class="border-t border-dashed border-line-strong py-2 font-bold">{gevonden.merk_type}</dd>
                {reparatie && (
                  <>
                    <dt class="border-t border-dashed border-line-strong py-2 text-ink-muted">Uitkomst</dt>
                    <dd class="border-t border-dashed border-line-strong py-2">
                      <StatusBadge status={reparatie.uitkomst!} />
                    </dd>
                    <dt class="border-t border-dashed border-line-strong py-2 text-ink-muted">Notitie</dt>
                    <dd class="border-t border-dashed border-line-strong py-2">{reparatie.notitie || 'Geen notitie'}</dd>
                    <dt class="border-t border-dashed border-line-strong py-2 text-ink-muted">Bestede tijd</dt>
                    <dd class="border-t border-dashed border-line-strong py-2">{reparatie.minuten} minuten</dd>
                  </>
                )}
              </dl>
              {!reparatie && <p class="mt-2 text-small text-ink-muted">De uitkomst verschijnt hier na de sessie.</p>}
            </Label>
          </div>
          <div class="flex flex-col gap-4 lg:pt-10">
            <Knop href="/status" variant="lijn" pijl>
              Andere aanmelding opvragen
            </Knop>
          </div>
        </>
      ) : (
        <>
          <form method="post" action="/status" novalidate class="werkbon flex min-w-0 flex-col gap-5">
            {nietGevonden && (
              <Alert soort="error" titel="Geen aanmelding gevonden.">
                Controleer het nummer en het e-mailadres en probeer het opnieuw.
              </Alert>
            )}
            {geblokkeerd && (
              <Alert soort="warn" titel="Te veel pogingen." id="geblokkeerd">
                Probeer het over een kwartier opnieuw.
              </Alert>
            )}

            <FormField
              id="s-referentie"
              name="referentie"
              label="Referentienummer"
              placeholder="RC-2026-0000"
              hint="Staat in je bevestigingsmail."
              autocapitalize="characters"
              autocomplete="off"
              mono
              value={invoer.referentie}
              error={fouten.referentie}
              autofocus={Boolean(fouten.referentie)}
              required
            />
            <FormField
              id="s-email"
              name="email"
              label="E-mailadres van je aanmelding"
              type="email"
              inputmode="email"
              autocomplete="email"
              value={invoer.email}
              error={fouten.email}
              autofocus={!fouten.referentie && Boolean(fouten.email)}
              required
            />

            {geblokkeerd ? (
              <Knop uit breed aria-describedby="geblokkeerd">
                Bekijken
              </Knop>
            ) : (
              <Knop type="submit" breed pijl>
                Bekijken
              </Knop>
            )}
          </form>

          <aside class="pt-6 lg:pt-10" aria-label="Waar vind je je referentienummer?">
            <Label as="div" kantel={2} variant="kraft" class="max-w-[22rem]">
              <p class="font-mono text-meta font-semibold tracking-[.16em]">ZO ZIET HET ERUIT</p>
              <p class="mt-1 font-mono text-2xl font-semibold">RC-JJJJ-NNNN</p>
              <hr class="scheur" />
              <p class="flex items-start gap-2 text-small">
                <Icon naam="info" maat={18} class="mt-0.5" />
                Je referentienummer staat op je bevestiging en in je bevestigingsmail. Samen met je e-mailadres zie je hier de status.
              </p>
            </Label>
          </aside>
        </>
      )
    }
  </div>
</Layout>

