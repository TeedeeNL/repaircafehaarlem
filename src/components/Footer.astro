---
import Logo from './Logo.astro';
import type { MenuItem } from '../lib/menu';

// Donkere voet met een perforatierand bovenaan, zoals een afscheurbon.
interface Props {
  info?: MenuItem[];
}
const { info = [] } = Astro.props;

const kolommen = [
  {
    titel: 'Meedoen',
    links: [
      { href: '/aanmelden', label: 'Apparaat aanmelden' },
      { href: '/status', label: 'Status opvragen' },
      { href: '/statistiek', label: 'Statistieken' },
    ],
  },
  { titel: 'Goed om te weten', links: info.map((i) => ({ href: i.href, label: i.label })) },
  { titel: 'Vrijwilligers', links: [{ href: '/login', label: 'Inloggen vrijwilligers' }] },
];
---

<footer class="voet relative mt-auto bg-ink text-paper">
  <div class="mx-auto grid max-w-page gap-10 px-rand pt-16 pb-10 md:grid-cols-[1.3fr_repeat(3,1fr)] md:gap-8">
    <div class="flex flex-col gap-4">
      <a href="/" class="group flex min-h-touch items-center gap-3 self-start text-paper no-underline hover:text-paper">
        <Logo />
        <span class="font-display text-xl font-extrabold">Repair Cafe Haarlem</span>
      </a>
      <p class="max-w-[30ch] text-small text-ink-licht">Elke eerste zaterdag van de maand samen spullen repareren.</p>
      <p class="font-mono text-meta text-ink-licht">
        <span class="text-paper">Waar:</span> [ADRES LOCATIE]
      </p>
    </div>

    {
      kolommen.map((k) => (
        <nav aria-label={k.titel} class="flex flex-col gap-2">
          <h2 class="font-mono text-meta font-semibold tracking-[.14em] text-ink-licht uppercase">{k.titel}</h2>
          <ul class="flex flex-col">
            {k.links.map((l) => (
              <li>
                <a href={l.href} class="flex min-h-touch items-center text-small text-paper hover:text-paper">
                  <span class="link-schuif">{l.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="mx-auto max-w-page px-rand pb-8">
    <p class="border-t border-dashed border-ink-line pt-6 font-mono text-meta text-ink-licht">© Repair Cafe Haarlem</p>
  </div>
</footer>

<style>
  /* Perforatierand: halve cirkels in papierkleur langs de bovenkant */
  .voet::before {
    content: '';
    position: absolute;
    inset: -1px 0 auto;
    height: 12px;
    background: radial-gradient(circle at 10px 0, var(--kleur-papier) 6px, transparent 6.5px) 0 0 / 20px 12px repeat-x;
  }
</style>
