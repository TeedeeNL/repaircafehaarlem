---
const links = [
  { href: '/statistiek', label: 'Statistieken' },
  { href: '/status', label: 'Status opvragen' },
  { href: '/login', label: 'Inloggen vrijwilligers' },
];
---

<footer class="bg-ink text-paper">
  <div class="mx-auto flex max-w-page flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-6 text-small">
    <span class="font-display font-extrabold">Repair Cafe Haarlem</span>
    <ul class="flex flex-wrap gap-x-5 gap-y-1">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="flex min-h-touch items-center text-paper hover:text-line">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
