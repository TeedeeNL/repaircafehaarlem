---
// Kaart "Eerstvolgende sessie" op de homepage. Wordt als server island geladen,
// zodat de homepage statisch blijft en de vrije plekken toch actueel zijn.
import Icon from './Icon.astro';
import PlekkenMeter from './PlekkenMeter.astro';
import { eerstvolgendeSessieMetPlek } from '../lib/db/sessie';
import { datumLang } from '../lib/format';
import { vandaag } from '../lib/tijd';

const sessie = await eerstvolgendeSessieMetPlek(vandaag());
---

<section aria-labelledby="volgende-sessie" class="sessie-kaart" data-kaart={sessie ? 'open' : 'leeg'}>
  <h2 id="volgende-sessie" class="flex items-center gap-2 font-mono text-meta font-semibold tracking-[.14em] text-ink-muted uppercase">
    <Icon naam="kalender" maat={18} class="text-rust" />
    Eerstvolgende sessie
  </h2>
  {
    sessie ? (
      <>
        <p class="mt-2 font-display text-2xl leading-[1.1] font-extrabold md:text-[1.75rem]">{datumLang(sessie.datum, false)}</p>
        <p class="flex items-center gap-1.5 text-ink-muted">
          <Icon naam="klok" maat={16} />
          vanaf {sessie.starttijd} uur
        </p>
        <hr class="my-4 border-0 border-t-thin border-dashed border-line-strong" />
        <PlekkenMeter bezet={sessie.bezet} max={sessie.max_plekken} />
      </>
    ) : (
      <>
        <p class="mt-2 font-display text-xl font-extrabold">De volgende datum wordt binnenkort bekend.</p>
        <p class="mt-1 text-small text-ink-muted">Aanmelden kan zodra de coördinator een nieuwe sessie heeft geopend.</p>
      </>
    )
  }
</section>

<style>
  .sessie-kaart {
    position: relative;
    padding: 1.25rem 1.25rem 1.25rem 1.5rem;
    background: var(--kleur-vlak);
    border: 1.5px solid var(--kleur-inkt);
    border-left: 6px solid var(--kleur-signaal);
    border-radius: var(--radius-md);
    box-shadow: var(--schaduw-kaart);
  }
  .sessie-kaart[data-kaart='leeg'] {
    border-left-color: var(--kleur-lijn-sterk);
    border-style: dashed;
    border-left-style: solid;
  }
</style>
