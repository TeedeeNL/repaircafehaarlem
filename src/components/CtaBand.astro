---
import Icon from './Icon.astro';
import Knop from './Knop.astro';

// Afsluitende oproep in de inktkleur, met een grote moersleutel die draait bij hover.
interface Props {
  titel: string;
  tekst: string;
}
const { titel, tekst } = Astro.props;
---

<section aria-labelledby="cta-kop" class="draai-ouder relative overflow-hidden bg-ink py-sectie text-paper">
  <Icon
    naam="tandwiel"
    maat={360}
    class="icoon-draai pointer-events-none absolute -top-16 -right-24 text-ink-line opacity-70 max-md:hidden"
  />
  <div class="relative mx-auto flex max-w-page flex-col gap-6 px-rand" data-reveal>
    <p class="font-mono text-meta font-semibold tracking-[.16em] text-signaal-licht uppercase">Tot op de werkbank</p>
    <h2 id="cta-kop" class="max-w-[16ch] font-display text-kop-2 font-extrabold tracking-[-0.02em]">{titel}</h2>
    <p class="max-w-[46ch] text-lead text-ink-licht">{tekst}</p>
    <div class="mt-2 flex flex-wrap gap-3">
      <Knop href="/aanmelden" pijl>Apparaat aanmelden</Knop>
      <Knop href="/status" variant="licht">Status opvragen</Knop>
    </div>
  </div>
</section>
