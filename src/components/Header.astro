---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import type { MenuItem } from '../lib/menu';
import type { Gebruiker } from '../lib/domein';

/**
 * Publiek: papieren balk met labelmerk, desktopmenu vanaf 1024px met inschuivende onderstreping,
 * daaronder een menuknop (aria-expanded, focusbeheer) met donker paneel.
 * Crew: donkere balk met gebruiker en uitloggen, tabs Werklijst, (alleen coördinator) Sessies en Mijn account.
 */
interface Props {
  variant: 'publiek' | 'crew';
  menu?: MenuItem[];
  pad?: string;
  gebruiker?: Gebruiker | null;
  tab?: 'werklijst' | 'sessies' | 'account' | null;
}
const { variant, menu = [], pad = Astro.url.pathname, gebruiker = null, tab = null } = Astro.props;
// Bij prerenderen eindigt het pad op .html (build.format 'file'); vergelijk zonder extensie en slash.
const schoon = pad.replace(/(\/index)?\.html$/, '').replace(/\/$/, '');
const huidig = (href: string) => (schoon === href ? 'page' : undefined);
---

{
  variant === 'publiek' ? (
    <header data-menu data-open="false" class="kop sticky top-0 z-30">
      <div class="mx-auto flex h-16 max-w-page items-center justify-between gap-4 px-rand lg:h-[76px]">
        <a href="/" class="kop-merk group flex min-h-touch items-center gap-3 no-underline">
          <Logo />
          <span class="leading-none">
            <span class="block font-display text-[1.1875rem] font-extrabold tracking-[-0.01em]">Repair Cafe</span>
            <span class="kop-merk-sub mt-1 block font-mono text-tiny font-semibold tracking-[.2em] uppercase">Haarlem</span>
          </span>
        </a>

        <nav aria-label="Hoofdmenu" class="hidden items-center gap-1 lg:flex">
          {menu.map((m) => (
            <a href={m.href} aria-current={huidig(m.href)} class="navlink">
              {m.kort}
            </a>
          ))}
        </nav>

        <div class="flex items-center gap-2">
          <a href="/aanmelden" class="knop knop-primair knop-klein max-sm:hidden">
            Apparaat aanmelden
            <Icon naam="pijl-rechts" maat={18} class="knop-pijl" />
          </a>
          <button
            type="button"
            data-menu-knop
            aria-expanded="false"
            aria-controls="mobiel-menu"
            class="knop knop-lijn knop-klein lg:hidden"
          >
            <Icon naam="menu" maat={20} class="menu-icoon-open" />
            <Icon naam="sluiten" maat={20} class="menu-icoon-dicht" />
            <span data-menu-tekst>Menu</span>
          </button>
        </div>
      </div>

      <nav id="mobiel-menu" aria-label="Hoofdmenu" hidden class="menu-paneel lg:hidden">
        <ul class="mx-auto flex max-w-page flex-col px-rand pt-2 pb-8">
          <li class="menu-regel" style="--i: 0">
            <a href="/" aria-current={huidig('')} class="menu-link">
              Home
            </a>
          </li>
          {menu.map((m, i) => (
            <li class="menu-regel" style={`--i: ${i + 1}`}>
              <a href={m.href} aria-current={huidig(m.href)} class="menu-link">
                {m.label}
              </a>
            </li>
          ))}
          <li class="menu-regel mt-6 flex flex-col gap-2" style={`--i: ${menu.length + 1}`}>
            <a href="/aanmelden" class="knop knop-primair w-full">
              Apparaat aanmelden
              <Icon naam="pijl-rechts" maat={18} class="knop-pijl" />
            </a>
            <a href="/login" class="knop knop-licht w-full">
              Inloggen vrijwilligers
            </a>
          </li>
        </ul>
      </nav>
    </header>
  ) : (
    <header class="bg-ink text-paper">
      <div class="mx-auto flex min-h-row max-w-page flex-wrap items-center justify-between gap-3 px-4">
        <a href={gebruiker ? '/crew' : '/login'} class="flex min-h-touch items-center gap-2 text-paper no-underline hover:text-line">
          <Logo maat="crew" />
          <span class="font-display text-small font-extrabold">
            <span class:list={[gebruiker && 'max-sm:hidden']}>Repair Cafe · </span>Crew
          </span>
        </a>
        {gebruiker && (
          <div class="flex items-center gap-3 text-sm">
            <span class="text-line max-sm:hidden">
              {gebruiker.naam} · {gebruiker.rol === 'coordinator' ? 'coördinator' : 'vrijwilliger'}
            </span>
            <form method="post" action="/uitloggen">
              <button
                type="submit"
                class="min-h-touch rounded-lg border border-line-strong px-3 text-sm font-bold text-paper hover:border-paper"
              >
                Uitloggen
              </button>
            </form>
          </div>
        )}
      </div>
      {gebruiker && (
        <nav aria-label="Crew" class="border-b border-line bg-surface text-ink">
          <div class="mx-auto flex max-w-page text-small font-bold md:px-4">
            <a
              href="/crew"
              aria-current={tab === 'werklijst' ? 'page' : undefined}
              class="flex min-h-touch items-center justify-center border-b-3 border-transparent px-4 text-ink-muted no-underline hover:text-ink aria-[current=page]:border-rust aria-[current=page]:text-ink max-md:flex-1"
            >
              Werklijst
            </a>
            {gebruiker.rol === 'coordinator' && (
              <a
                href="/beheer/sessies"
                aria-current={tab === 'sessies' ? 'page' : undefined}
                class="flex min-h-touch items-center justify-center border-b-3 border-transparent px-4 text-ink-muted no-underline hover:text-ink aria-[current=page]:border-rust aria-[current=page]:text-ink max-md:flex-1"
              >
                Sessies
              </a>
            )}
            <a
              href="/crew/account"
              aria-current={tab === 'account' ? 'page' : undefined}
              class="flex min-h-touch items-center justify-center border-b-3 border-transparent px-4 text-ink-muted no-underline hover:text-ink aria-[current=page]:border-rust aria-[current=page]:text-ink max-md:flex-1 md:ml-auto"
            >
              Mijn account
            </a>
          </div>
        </nav>
      )}
    </header>
  )
}

<script>
  // Mobiel menu: echte knop met aria-expanded, focus naar de eerste link bij openen,
  // terug naar de knop bij sluiten (Escape of knop), en dicht zodra de focus het menu verlaat.
  const header = document.querySelector<HTMLElement>('[data-menu]');
  const knop = header?.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const tekst = header?.querySelector<HTMLElement>('[data-menu-tekst]');
  const paneel = document.getElementById('mobiel-menu');
  if (header && knop && paneel) {
    const zet = (open: boolean, focusTerug = false) => {
      header.dataset.open = String(open);
      knop.setAttribute('aria-expanded', String(open));
      if (tekst) tekst.textContent = open ? 'Sluiten' : 'Menu';
      paneel.hidden = !open;
      document.documentElement.classList.toggle('menu-open', open);
      if (open) paneel.querySelector<HTMLAnchorElement>('a')?.focus();
      else if (focusTerug) knop.focus();
    };
    knop.addEventListener('click', () => zet(paneel.hidden !== false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !paneel.hidden) zet(false, true);
    });
    header.addEventListener('focusout', (e) => {
      if (!paneel.hidden && e.relatedTarget instanceof Node && !header.contains(e.relatedTarget)) zet(false);
    });
    matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && zet(false));
  }
</script>
