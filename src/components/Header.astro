---
import Logo from './Logo.astro';
import type { MenuItem } from '../lib/menu';
import type { Vrijwilliger } from '../lib/mock';

/**
 * Publiek: lichte balk, desktopmenu vanaf 1024px, daaronder een menuknop met donker paneel.
 * Crew: donkere balk met gebruiker en uitloggen, tabs Werklijst en (alleen coördinator) Sessies.
 */
interface Props {
  variant: 'publiek' | 'crew';
  menu?: MenuItem[];
  pad?: string;
  menuOpen?: boolean;
  gebruiker?: Vrijwilliger | null;
  tab?: 'werklijst' | 'sessies' | null;
}
const { variant, menu = [], pad = Astro.url.pathname, menuOpen = false, gebruiker = null, tab = null } = Astro.props;
const huidig = (href: string) => (pad.replace(/\/$/, '') === href ? 'page' : undefined);
---

{
  variant === 'publiek' ? (
    <header
      data-menu
      data-open={String(menuOpen)}
      class="group sticky top-0 z-10 border-b border-line bg-paper data-[open=true]:border-ink-line data-[open=true]:bg-ink data-[open=true]:text-paper"
    >
      <div class="mx-auto flex max-w-page items-center justify-between gap-4 px-4 py-2.5 lg:py-3.5">
        <a href="/" class="flex min-h-touch items-center gap-2.5 text-ink no-underline group-data-[open=true]:text-paper">
          <Logo />
          <span class="font-display text-lead leading-[1.05] font-extrabold lg:text-[19px]">
            Repair Cafe{' '}
            <br class="lg:hidden" />
            <span class="text-sm font-semibold text-ink-muted group-data-[open=true]:text-line lg:text-[19px]">Haarlem</span>
          </span>
        </a>

        <nav aria-label="Hoofdmenu" class="hidden items-center gap-1 text-small font-bold lg:flex">
          {menu.map((m) => (
            <a
              href={m.href}
              aria-current={huidig(m.href)}
              class="flex min-h-touch items-center px-3 text-ink underline decoration-transparent decoration-3 underline-offset-8 hover:decoration-line-strong aria-[current=page]:decoration-rust"
            >
              {m.kort}
            </a>
          ))}
          <a
            href="/login"
            class="ml-2 flex min-h-touch items-center rounded-lg border-thin border-ink px-3.5 text-ink no-underline hover:bg-surface"
          >
            Inloggen
          </a>
        </nav>

        <button
          type="button"
          data-menu-knop
          aria-expanded={menuOpen}
          aria-controls="mobiel-menu"
          class="min-h-touch min-w-touch rounded-lg border-thin border-ink px-3.5 text-small font-bold group-data-[open=true]:border-paper group-data-[open=true]:text-paper lg:hidden"
        >
          {menuOpen ? 'Sluiten' : 'Menu'}
        </button>
      </div>

      <nav id="mobiel-menu" aria-label="Hoofdmenu" hidden={!menuOpen} class="bg-ink px-4 pb-6 text-paper lg:hidden">
        <a
          href="/"
          aria-current={huidig('')}
          class="flex min-h-row items-center border-b border-ink-line font-display text-2xl font-extrabold text-paper underline decoration-transparent decoration-3 underline-offset-6 aria-[current=page]:decoration-rust-300"
        >
          Home
        </a>
        {menu.map((m) => (
          <a
            href={m.href}
            aria-current={huidig(m.href)}
            class="flex min-h-row items-center border-b border-ink-line font-display text-2xl font-extrabold text-paper underline decoration-transparent decoration-3 underline-offset-6 aria-[current=page]:decoration-rust-300"
          >
            {m.label}
          </a>
        ))}
        <a
          href="/aanmelden"
          class="mt-4 flex min-h-btn-lg items-center justify-center rounded-lg bg-rust text-lead font-bold text-surface no-underline hover:bg-rust-700 hover:text-surface"
        >
          Apparaat aanmelden
        </a>
        <a href="/login" class="flex min-h-btn items-center justify-center font-bold text-paper hover:text-line">
          Inloggen vrijwilligers
        </a>
      </nav>
    </header>
  ) : (
    <header class="bg-ink text-paper">
      <div class="mx-auto flex min-h-row max-w-page flex-wrap items-center justify-between gap-3 px-4">
        <a href={gebruiker ? '/crew' : '/login'} class="flex min-h-touch items-center gap-2 text-paper no-underline hover:text-line">
          <Logo maat="crew" />
          <span class="font-display text-small font-extrabold">
            <span class:list={[gebruiker && 'max-sm:hidden']}>Repair Cafe · </span>Crew
          </span>
        </a>
        {gebruiker && (
          <div class="flex items-center gap-3 text-sm">
            <span class="text-line max-sm:hidden">
              {gebruiker.naam} · {gebruiker.rol === 'coordinator' ? 'coördinator' : 'vrijwilliger'}
            </span>
            <form method="post" action="/login">
              <input type="hidden" name="actie" value="uitloggen" />
              <button
                type="submit"
                class="min-h-touch rounded-lg border border-line-strong px-3 text-sm font-bold text-paper hover:border-paper"
              >
                Uitloggen
              </button>
            </form>
          </div>
        )}
      </div>
      {gebruiker && (
        <nav aria-label="Crew" class="border-b border-line bg-surface text-ink">
          <div class="mx-auto flex max-w-page text-small font-bold md:px-4">
            <a
              href="/crew"
              aria-current={tab === 'werklijst' ? 'page' : undefined}
              class="flex min-h-touch items-center justify-center border-b-3 border-transparent px-4 text-ink-muted no-underline hover:text-ink aria-[current=page]:border-rust aria-[current=page]:text-ink max-md:flex-1"
            >
              Werklijst
            </a>
            {gebruiker.rol === 'coordinator' && (
              <a
                href="/beheer/sessies"
                aria-current={tab === 'sessies' ? 'page' : undefined}
                class="flex min-h-touch items-center justify-center border-b-3 border-transparent px-4 text-ink-muted no-underline hover:text-ink aria-[current=page]:border-rust aria-[current=page]:text-ink max-md:flex-1"
              >
                Sessies
              </a>
            )}
          </div>
        </nav>
      )}
    </header>
  )
}

<script>
  const header = document.querySelector<HTMLElement>('[data-menu]');
  const knop = header?.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const paneel = document.getElementById('mobiel-menu');
  if (header && knop && paneel) {
    const zet = (open: boolean) => {
      header.dataset.open = String(open);
      knop.setAttribute('aria-expanded', String(open));
      knop.textContent = open ? 'Sluiten' : 'Menu';
      paneel.hidden = !open;
    };
    knop.addEventListener('click', () => zet(paneel.hidden !== false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !paneel.hidden) {
        zet(false);
        knop.focus();
      }
    });
    matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && zet(false));
  }
</script>
