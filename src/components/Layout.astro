---
import '../styles/global.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import DevStates from './DevStates.astro';
import { hoofdmenu } from '../lib/menu';
import type { StateOptie } from '../lib/state';
import type { Vrijwilliger } from '../lib/mock';

interface Props {
  titel: string;
  beschrijving?: string;
  variant?: 'publiek' | 'crew';
  menuOpen?: boolean;
  gebruiker?: Vrijwilliger | null;
  tab?: 'werklijst' | 'sessies' | null;
  states?: readonly StateOptie<string>[];
  state?: string | null;
}
const {
  titel,
  beschrijving = 'Repair Cafe Haarlem: elke eerste zaterdag van de maand repareren vrijwilligers gratis je apparaat.',
  variant = 'publiek',
  menuOpen = false,
  gebruiker = null,
  tab = null,
  states = [],
  state = null,
} = Astro.props;

const menu = variant === 'publiek' ? await hoofdmenu() : [];
const volledigeTitel = titel === 'Repair Cafe Haarlem' ? titel : `${titel} · Repair Cafe Haarlem`;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={beschrijving} />
    {variant === 'crew' && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <title>{volledigeTitel}</title>
  </head>
  <body class:list={['flex min-h-dvh flex-col', variant === 'crew' ? 'bg-surface' : 'bg-paper']}>
    <a
      href="#inhoud"
      class="sr-only z-50 rounded-lg bg-ink px-4 py-3 font-bold text-surface focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
    >
      Naar de inhoud
    </a>
    <Header variant={variant} menu={menu} menuOpen={menuOpen} gebruiker={gebruiker} tab={tab} />
    <main id="inhoud" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    {variant === 'publiek' && <Footer />}
    <DevStates opties={states} huidig={state} />
  </body>
</html>
