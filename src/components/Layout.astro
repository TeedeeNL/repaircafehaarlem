---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { hoofdmenu, infoPaginas } from '../lib/menu';
import type { Gebruiker } from '../lib/domein';

interface Props {
  titel: string;
  beschrijving?: string;
  variant?: 'publiek' | 'crew';
  gebruiker?: Gebruiker | null;
  tab?: 'werklijst' | 'sessies' | null;
}
const {
  titel,
  beschrijving = 'Repair Cafe Haarlem: elke eerste zaterdag van de maand repareren vrijwilligers gratis je apparaat.',
  variant = 'publiek',
  gebruiker = null,
  tab = null,
} = Astro.props;

const menu = variant === 'publiek' ? await hoofdmenu() : [];
const info = variant === 'publiek' ? await infoPaginas() : [];
const volledigeTitel = titel === 'Repair Cafe Haarlem' ? titel : `${titel} · Repair Cafe Haarlem`;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={beschrijving} />
    {variant === 'crew' && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <Font cssVariable="--font-rc-display" preload />
    <Font cssVariable="--font-rc-tekst" preload />
    <Font cssVariable="--font-rc-mono" />
    <title>{volledigeTitel}</title>
    <!-- Vóór het eerste tekenen: markeer dat JS werkt, zodat reveals alleen dan iets verbergen. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class:list={['flex min-h-dvh flex-col', variant === 'crew' ? 'bg-surface' : 'bg-paper']}>
    <a
      href="#inhoud"
      class="sr-only z-50 rounded-lg bg-ink px-4 py-3 font-bold text-surface focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
    >
      Naar de inhoud
    </a>
    <Header variant={variant} menu={menu} gebruiker={gebruiker} tab={tab} />
    <main id="inhoud" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    {variant === 'publiek' && <Footer info={info} />}

    <script>
      // Scroll-reveals: [data-reveal] krijgt .zichtbaar zodra het in beeld komt (één keer).
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const rustig = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (rustig || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('zichtbaar'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('zichtbaar');
              io.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
